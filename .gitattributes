# Go dependencies
go.sum linguist-generated
vendor/* linguist-vendored
api/go.sum linguist-generated
api/vendor/* linguist-vendored
pkg/k8s/go.sum linguist-generated
pkg/k8s/vendor/* linguist-vendored

# API
api/v1/README.md linguist-generated
api/v1/tetragon/*.go linguist-generated

# CRDs
pkg/k8s/apis/cilium.io/client/crds/* linguist-generated
pkg/k8s/apis/cilium.io/*/zz_generated.*.go linguist-generated
pkg/k8s/client/* linguist-generated

# Helm chart
install/kubernetes/tetragon/* linguist-generated
install/kubernetes/openapi2jsonschema.py linguist-vendored
install/kubernetes/tracingpolicy_v1alpha1.json linguist-generated

# docs
docs/metrics/metrics.md linguist-generated

# Pick the "ours" merge strategy for code generated files. This avoids the
# changes showing up in git mergetool since we would need to re-run the code
# generation as part of the rebase anyway.
./**/*.pb merge=ours
./**/*.pb.* merge=ours
./api/v1/README.md merge=ours
./pkg/k8s/client/**/*.go merge=ours
./pkg/k8s/apis/**/*.go merge=ours
./pkg/abicalls/*.go merge=ours
./install/kubernetes/tetragon/Chart.yaml merge=ours
./install/kubernetes/tetragon/values.yaml merge=ours
./install/kubernetes/tetragon/README.md merge=ours
