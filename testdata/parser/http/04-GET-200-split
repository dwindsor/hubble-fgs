INGRESSPORT 8888

# Connection has been established and we should see:
# listen, accept and connect sockets.

# Split method into individual messages to make sure the parser can handle it.
EGRESS
	"G"
END
EGRESS
	"E"
END
EGRESS
	"T"
END
EGRESS
	" / HTTP/1.1\r\n"
	"Host: foobar.baz\r\n"
	"\r\n"
END

# Event from the client socket.
EVENT http
  $ 8f 00 00 00 # op + pad
  h4 172        # size
  NZ 8          # ktime

  ## socket cookie
  ? 8                       # socket cookie
  ? 8                       # version and pad

  TUPLE CLI SRV

  ## process
  NZ 4          # pid should be set.
  $ 00 00 00 00 # pad
  $ ef be ad de 04 03 02 01 # ktime

  ## http
  h4 3          # method=GET
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 00 00 00 00 00 00 00 00 # recv
  h8 44 		    # length

  ## payload
  h4 1 # type: request_url
  h4 1 # length
  "/"

  h4 3 # type: request_protocol
  h4 8 # length
  "HTTP/1.1"

  h4 2  # type: request_host
  h4 11 # length
  " foobar.baz"
END

# Event from the server socket.
EVENT http
  $ 8f 00 00 00 # op + pad
  h4 172        # size
  NZ 8          # ktime

  ## socket cookie
  ? 8                       # socket cookie
  ? 8                       # version and pad

  TUPLE SRV CLI

  ## process
  NZ 4          # pid should be set.
  $ 00 00 00 00 # pad
  $ ef be ad de 04 03 02 01 # ktime

  ## http
  h4 3          # method=GET
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 00 00 00 00 00 00 00 00 # recv
  h8 44			    # length

  ## payload
  h4 1 # type: request_url
  h4 1 # length
  "/"

  h4 3 # type: request_protocol
  h4 8 # length
  "HTTP/1.1"

  h4 2  # type: request_host
  h4 11 # length
  " foobar.baz"
END

INGRESS
	"HTTP/1.1 200 OK\r\n"
	"Location: http://foobar.baz\r\n"
	"Content-Length: 5\r\n"
	"\r\n"
	"hello"
END

EVENT http
  $ 8f 00 00 00 # op + pad
  h4 201        # size
  NZ 8          # ktime

  ## socket cookie
  ? 8                       # socket cookie
  ? 8                       # version and pad

  TUPLE SRV CLI

  ## process
  NZ 4          # pid should be set.
  $ 00 00 00 00 # pad
  $ ef be ad de 04 03 02 01 # ktime

  ## http
  h4 11         # method=GET
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 01 00 00 00 00 00 00 00 # recv
  h8 73			    # length

  ## payload
  h4 8 # type: response_protocol
  h4 8 # length
  "HTTP/1.1"

  h4 9 # type: response_code
  h4 3 # length
  "200"

  h4 10 # type: response_reason
  h4 2  # length
  "OK"

  h4 7  # type: request_unknown
  h4 18 # length
  " http://foobar.baz"

  h4 6 # type: request_content_length
  h4 2 # length
  " 5"

  $ 00 00 00
END

EVENT http
  $ 8f 00 00 00 # op + pad
  h4 201        # size
  NZ 8          # ktime

  ## socket cookie
  ? 8                       # socket cookie
  ? 8                       # version and pad

  TUPLE CLI SRV
  
  ## process
  NZ 4          # pid should be set.
  $ 00 00 00 00 # pad
  $ ef be ad de 04 03 02 01 # ktime

  ## http
  h4 11         # method=GET
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 01 00 00 00 00 00 00 00 # recv
  h8 73			    # length

  ## payload
  h4 8 # type: response_protocol
