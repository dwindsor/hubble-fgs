EGRESS
	"GET /foo HTTP/1.1\r\n"
	"Host: foobar.baz\r\n"
	"\r\n"
END

# Event from the client socket.
EVENT http
  $ 10 00 00 00 # op + pad
  $ 64 06 00 00 # size
  ? 8           # ktime

  ## tuple
  A CLI_ADDR
  A SRV_ADDR
  A SRV_PORT
  A CLI_PORT_HOST
  $ 00 00 00 00             # direction (egress)
  $ 00 00 00 00 00 00 00 00 # uid

  ## process
  ? 4           # pid
  $ 00 00 00 00 # pad
  ? 8           # ktime

  ## http
  h4 3          # method=GET
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 00 00 00 00 00 00 00 00 # recv

  ## payload
  h4 1 # type: request_url
  h4 4 # length
  "/foo"

  h4 3 # type: request_protocol
  h4 8 # length
  "HTTP/1.1"

  h4 2  # type: request_host
  h4 11 # length
  " foobar.baz"

  # termination
  h4 0
  h4 0

  ? 981
END

