EGRESS
	"POST / HTTP/1.1\r\n"
	"Host: foobar.baz\r\n"
	"Content-Length: 10\r\n"
	"\r\n"
	"helloworld"
END

# Event from the client socket.
EVENT http
  $ 10 00 00 00 # op + pad
  $ 5C 04 00 00 # size
  NZ 8          # ktime

  ## tuple
  A CLI_ADDR
  A SRV_ADDR
  A SRV_PORT
  A CLI_PORT_HOST
  $ 00 00 00 00 # direction (egress)
  NZ 8          # netns id

  ## process
  NZ 4          # pid
  $ 00 00 00 00 # pad
  $ ef be ad de 04 03 02 01 # ktime

  ## http
  h4 6          # method=POST
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 00 00 00 00 00 00 00 00 # recv

  ## payload
  h4 1 # type: request_url
  h4 1 # length
  "/"

  h4 3 # type: request_protocol
  h4 8 # length
  "HTTP/1.1"

  h4 2  # type: request_host
  h4 11 # length
  " foobar.baz"

  h4 6 # type: request_content_length
  h4 3 # length
  " 10"

  # termination
  h4 0
  h4 0

  ? 973
END

