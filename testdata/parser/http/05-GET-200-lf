INGRESSPORT 8888

# Connection has been established and we should see:
# listen, accept and connect sockets.

EGRESS
	"GET / HTTP/1.1\n"
	"Host: foobar.baz\n"
	"\n"
END

# Event from the client socket.
EVENT http
  $ 10 00 00 00 # op + pad
  h4 124        # size
  NZ 8          # ktime

  ## socket cookie
  ? 8                       # socket cookie
  ? 8                       # version and pad

  ## process
  NZ 4          # pid should be set.
  $ 00 00 00 00 # pad
  $ ef be ad de 04 03 02 01 # ktime

  ## http
  h4 3          # method=GET
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 00 00 00 00 00 00 00 00 # recv
  h8 44			    # length

  ## payload
  h4 1 # type: request_url
  h4 1 # length
  "/"

  h4 3 # type: request_protocol
  h4 8 # length
  "HTTP/1.1"

  h4 2  # type: request_host
  h4 11 # length
  " foobar.baz"
END

# Event from the server socket.
EVENT http
  $ 10 00 00 00 # op + pad
  h4 124        # size
  NZ 8          # ktime

  ## socket cookie
  ? 8                       # socket cookie
  ? 8                       # version and pad

  ## process
  NZ 4          # pid should be set.
  $ 00 00 00 00 # pad
  $ ef be ad de 04 03 02 01 # ktime

  ## http
  h4 3          # method=GET
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 00 00 00 00 00 00 00 00 # recv
  h8 44			    # length

  ## payload
  h4 1 # type: request_url
  h4 1 # length
  "/"

  h4 3 # type: request_protocol
  h4 8 # length
  "HTTP/1.1"

  h4 2  # type: request_host
  h4 11 # length
  " foobar.baz"
END

INGRESS
