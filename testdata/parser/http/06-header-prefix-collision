INGRESSPORT 8888

# Regression test for the prefix-match bug in __strncmp_truncated
# (bpf/lib/strncmp.h). A header name that is a strict superset of a
# recognized header (here "Hostname", which has "host" as a prefix) must
# NOT be classified as that header. We assert the value is captured as
# request_unknown (type 7), not request_host (type 2).
#
# On a buggy build the chunk type is 2 (request_host) and this test fails.

EGRESS
	"GET / HTTP/1.1\r\n"
	"Hostname: foobar.baz\r\n"
	"\r\n"
END

# Event from the client socket.
EVENT http
  $ 8f 00 00 00 # op + pad
  h4 172        # size
  NZ 8          # ktime

  ## socket cookie
  ? 8                       # socket cookie
  ? 8                       # version and pad

  TUPLE CLI SRV

  ## process
  NZ 4          # pid should be set.
  $ 00 00 00 00 # pad
  $ ef be ad de 04 03 02 01 # ktime

  ## http
  h4 3          # method=GET
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 00 00 00 00 00 00 00 00 # recv
  h8 44			    # length

  ## payload
  h4 1 # type: request_url
  h4 1 # length
  "/"

  h4 3 # type: request_protocol
  h4 8 # length
  "HTTP/1.1"

  h4 7  # type: request_unknown (NOT request_host)
  h4 11 # length
  " foobar.baz"
END

# Event from the server socket.
EVENT http
  $ 8f 00 00 00 # op + pad
  h4 172        # size
  NZ 8          # ktime

  ## socket cookie
  ? 8                       # socket cookie
  ? 8                       # version and pad

  TUPLE SRV CLI

  ## process
  NZ 4          # pid should be set.
  $ 00 00 00 00 # pad
  $ ef be ad de 04 03 02 01 # ktime

  ## http
  h4 3          # method=GET
  h4 0x0        # flags
  $ 01 00 00 00 00 00 00 00 # send
  $ 00 00 00 00 00 00 00 00 # recv
  h8 44			    # length

  ## payload
  h4 1 # type: request_url
  h4 1 # length
  "/"

  h4 3 # type: request_protocol
  h4 8 # length
  "HTTP/1.1"

  h4 7  # type: request_unknown (NOT request_host)
  h4 11 # length
  " foobar.baz"
END

# Close both sockets.
CLOSE
