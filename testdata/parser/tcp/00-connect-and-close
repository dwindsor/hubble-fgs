  $ 08 00 00 00 # op+pad
  h4 228       # size
  ? 8           # ktime

  ## tuple
  A SRV_ADDR
  $ 00 00 00 00 00 00 00 00 00 00 00 00 # pad to IPv6
  A CLI_ADDR
  $ 00 00 00 00 00 00 00 00 00 00 00 00 # pad to IPv6
  A CLI_PORT
  A SRV_PORT_HOST
  $ 00                      # proto
