# Connection has been established and we should see 3 sockets:
# accept, connect and listen.

EGRESS
	"hello"
END

INGRESS
	"bye"
END

EVENT TCPACCEPT
  $ 09 00 00 00 # op+pad
  h4 228        # size
  ? 8           # ktime

  ## tuple
  A SRV_ADDR
  $ 00 00 00 00 00 00 00 00 00 00 00 00 # pad to IPv6
  A CLI_ADDR
  $ 00 00 00 00 00 00 00 00 00 00 00 00 # pad to IPv6
  A CLI_PORT
  A SRV_PORT_HOST
  $ 00                      # proto
  $ 00 00 00 00             # post daddr
  $ 00 00                   # post dport
  $ 00 00 00 00 00          # pad
  $ 00 00 00 00 00 00 00 00 # ret

  ## process key
  $ ?? ?? ?? ??         # pid
  $ 00 00 00 00         # pad
  h8 0x01020304deadbeef # ktime
  ? 8                   # socket cookie

  ## socket stats, zeroes for ACCEPT
  $ ?? ?? ?? ?? ?? ?? ?? ?? # Ktime
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00

  ## socket flags
  h4 0x00

  h4 0x00 # pad
END

