  ## process key
  $ ?? ?? ?? ??         # pid
  $ 00 00 00 00         # pad
  h8 0x01020304deadbeef # ktime
  ? 8                   # socket cookie

  ## socket stats
  $ ?? ?? ?? ?? ?? ?? ?? ?? # Ktime
  h8 3 # bytes sent
  h8 5 # bytes received
  NZ 4 # segs in
  NZ 4 # segs out
  ? 4  # srtt
  h4 0 # retransmitted segs
  h8 0 # retransmitted bytes
  h4 0 # to zero window
