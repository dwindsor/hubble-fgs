INGRESSPORT 8888

# Connection has been established and we should see 3 sockets:
# accept, connect and listen.

EGRESS
	"hello"
END

INGRESS
	"bye"
END

EVENT TCPACCEPT
  $ 09 00 00 00 # op+pad
  h4 112        # size
  ? 8           # ktime

  ## tuple
  TUPLE SRV CLI

  ## ret
  $ 00 00 00 00 00 00 00 00 # ret

  ## process key
  $ ?? ?? ?? ??         # pid
  $ 00 00 00 00         # pad
  h8 0x01020304deadbeef # ktime
  
  ## socket cookie
  ? 8                   # socket cookie

  ## socket flags
  h4 0x00

  ## pad
  $ 00 00 00 00

  ## duration
  $ 00 00 00 00 00 00 00 00

  h4 0x00 # pad
  # ^ Where is the extra 4 byte padding coming from?

END

EVENT TCPCONNECTRET
  $ 02 00 00 00 # op+pad
  h4 112        # size
  ? 8           # ktime

  ## tuple
  TUPLE CLI SRV

  ## ret
  $ 00 00 00 00 00 00 00 00 # ret

  ## process key
  $ ?? ?? ?? ?? # pid
  $ 00 00 00 00 # pad
  h8 0x01020304deadbeef # ktime
  ? 8 # socket cookie

  ## socket flags
  h4 0x00

  ## pad
  $ 00 00 00 00

  ## duration
  $ 00 00 00 00 00 00 00 00

  $ 00 00 00 00
  # ^ Where is the padding coming from?
END

# Close the server socket first
CLOSE SERVER

EVENT TCPCLOSE
  $ 08 00 00 00 # op+pad
  h4 352        # size
  ? 8           # ktime

  ## tuple
  TUPLE SRV CLI

  ## ret
  $ 00 00 00 00 00 00 00 00 # ret

  ## process key
  $ ?? ?? ?? ??         # pid
  $ 00 00 00 00         # pad
  h8 0x01020304deadbeef # ktime
  ? 8                   # socket cookie

  ## socket flags
  h4 0x02 # accept

  ## pad
  $ 00 00 00 00

  ## duration
  ? 8

  ## socket stats
  $ ?? ?? ?? ?? ?? ?? ?? ?? # Ktime
  h8 0 # create ktime
  h8 3 # bytes sent
  h8 5 # bytes received
  NZ 4 # segs in
  NZ 4 # segs out
  ? 8  # bytes submitted
  ? 8  # bytes consumed
  ? 4  # segs consumed
  ? 4  # segs submitted
  ? 4  # srtt
  h4 0 # retransmitted segs
  h8 0 # retransmitted bytes
  h4 0 # to zero window
  h4 0 # skdrop
  h4 0 # skbconsumemisses
  h4 0 # pad
  $ 00 00 00 00 00 00 00 00 # rtt buckets X 8
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00 # rtt sum
  $ 00 00 00 00 00 00 00 00 # latency buckets X 8
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00
  $ 00 00 00 00 00 00 00 00 # latency sum

  h4 0x00 # pad
  # ^ Where is the extra 4 byte padding coming from?
END

