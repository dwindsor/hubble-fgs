apiVersion: cilium.io/v1alpha1
kind: TracingPolicy
metadata:
  name: "file-monitoring-enforce"
spec:
  file:
    file_paths:
    - {{.MatchedPath}}
    monitorHostFiles: true
    selectors:
    - matchOperations:
      - operator: "In"
        values:
        - {{.MatchedOperation}}
      matchActions:
      - action: Block
