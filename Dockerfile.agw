# First collect gmni used for testing
FROM --platform=$BUILDPLATFORM ghcr.io/openconfig/gnmic:0.45.0@sha256:d422a9ebd4a2b78e1f501cf8a488cab1f7afc2774b7ea983d2316f4dd449a924 AS gnmic
ARG TARGETARCH

# Second builder (cross-)compile:
# - agw
# - agwctl
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26.1@sha256:595c7847cff97c9a9e76f015083c481d26078f961c9c8dca3923132f51fe12f1 AS agw-builder
WORKDIR /go/src/github.com/isovalent/hubble-fgs
ARG TARGETARCH BUILDARCH
RUN apt-get update && apt-get upgrade -y
RUN if [ $BUILDARCH != $TARGETARCH ]; \
    then apt-get install -y libelf-dev zlib1g-dev crossbuild-essential-$TARGETARCH; \
    else apt-get install -y libelf-dev zlib1g-dev; fi
RUN ldconfig /usr/local/
COPY . ./
RUN if [ $BUILDARCH != $TARGETARCH ]; \
    then make agw agwctl TARGET_ARCH=$TARGETARCH CC=aarch64-linux-gnu-gcc; \
    else make agw agwctl TARGET_ARCH=$TARGETARCH; fi
RUN apt-get update \
    && apt-get install -y --no-install-recommends ntpsec \
    && mkdir -p /ntpsec-dist/lib \
    && cp /usr/sbin/ntpd /ntpsec-dist/ \
    && ldd /usr/sbin/ntpd | awk '/=>/{print $3}' \
       | xargs -I{} cp -L {} /ntpsec-dist/lib/ \
    && apt-get autoremove -y && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Third builder (cross-)compile a stripped gops
FROM --platform=$BUILDPLATFORM docker.io/library/golang:1.26.1-alpine@sha256:2389ebfa5b7f43eeafbd6be0c3700cc46690ef842ad962f6c5bd6be49ed82039 AS gops
ARG TARGETARCH
RUN apk update && apk upgrade && apk add --no-cache binutils git \
 && git clone https://github.com/google/gops /go/src/github.com/google/gops \
 && cd /go/src/github.com/google/gops \
 && git checkout -b v0.3.27 v0.3.27 \
 && GOARCH=$TARGETARCH go build -ldflags="-s -w" .
RUN apk cache clean

# Final step run on target platform — Chainguard glibc-openssl (glibc-native, apk + shell)
FROM artifactory.devhub-cloud.cisco.com/sto-cg-docker/glibc-openssl:v15.2-dev AS base-build
USER root
RUN apk update && apk upgrade --no-cache
RUN apk add --no-cache net-tools iproute2 netcat-openbsd curl openssh-client bind-tools iputils logrotate cronie sshpass bash ca-certificates openssl fluent-bit-4.0
RUN echo 'PS1="HypershieldAgent:\w# "' >> /etc/bash.bashrc
ENV PATH="/usr/src/app:${PATH}"
COPY --from=agw-builder /ntpsec-dist/ntpd /usr/sbin/ntpd
COPY --from=agw-builder /ntpsec-dist/lib/ /tmp/ntpsec-lib/
RUN for f in /tmp/ntpsec-lib/*; do \
      name=$(basename "$f"); \
      found=false; \
      for d in /lib /usr/lib; do [ -e "$d/$name" ] && found=true && break; done; \
      $found || cp "$f" /usr/lib/; \
    done && rm -rf /tmp/ntpsec-lib && ldconfig
RUN mkdir -p /usr/src/app
RUN mkdir -p /opt/cisco/daf/etc
RUN mkdir -p /opt/cisco/daf/log
RUN mkdir -p /opt/cisco/hypershield/etc
RUN mkdir -p /etc/ssl/certs
RUN mkdir -p /data/volatile
RUN mkdir -p /iox_data
RUN mkdir -p /iox_data/isovalent/policy
WORKDIR /usr/src/app
#COPY --from=gnmic /app/gnmic ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/agw ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/agwctl ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/agwctl.sh ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/health.sh ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/post.sh ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/cleanup.sh ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/init.sh ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/policy-allowall.json ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/dafconfig /opt/cisco/daf/etc
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/ntp.conf /etc/ntpsec
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/crontab ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/logrotate.hs /etc/logrotate.d/hs
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/restart-fwa.sh ./
RUN chmod 600 /etc/logrotate.d/hs
# Install Fluent Bit configuration (YAML, same path AGW writes dynamically)
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/fluent-bit.yaml /data/hypershield/daflogger.yaml
RUN mkdir -p /var/log/fluent-bit /data/hypershield
EXPOSE 8880 8881 8882
ENTRYPOINT ["./init.sh"]

# Test container for headless testing (no NXOS dependencies)
# It container env vars for all AGW configuration flags, which can be overwritten at runtime
FROM artifactory.devhub-cloud.cisco.com/sto-cg-docker/glibc-openssl:v15.2-dev AS agw-test
USER root
ENV AGW_CONFIG="" \
    AGW_NETWORK_POLICY="" \
    AGW_ENABLE_K8S="false" \
    AGW_ENABLE_NXOS="false" \
    AGW_DPU_SERVER_ADDRESS="0.0.0.0:8880" \
    AGW_VRF_MAP="" \
    AGW_DEBUG="false" \
    AGW_K8S_SERVICE_ACCOUNT_AUTH="" \
    AGW_TIMESCAPE_CLIENT_ENABLE="false" \
    AGW_TIMESCAPE_PASSWORD="" \
    AGW_TIMESCAPE_ENDPOINT="" \
    AGW_FLB_SOCKET_PATH="/tmp/fluentbit_agw.sock" \
    AGW_FLB_CONFIG_PATH="/data/hypershield/daflogger.yaml" \
    FLUENT_BIT_CONFIG="/data/hypershield/daflogger.yaml" \
    FLUENT_BIT_METRICS_URL="http://localhost:2020/api/v1/metrics"
EXPOSE 8880
WORKDIR /usr/src/app
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/agw ./
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/agwctl ./
RUN apk add --no-cache fluent-bit-4.0
RUN echo 'PS1="HypershieldAgent:\w# "' >> /etc/bash.bashrc
ENV PATH="/usr/src/app:${PATH}"
RUN mkdir -p /opt/cisco/daf/etc
RUN mkdir -p /iox_data
RUN mkdir -p /data/hypershield
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/dafconfig /opt/cisco/daf/etc
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/fluent-bit.yaml /data/hypershield/daflogger.yaml
COPY --from=agw-builder /go/src/github.com/isovalent/hubble-fgs/install/agw/test-entrypoint.sh /usr/src/app/entrypoint.sh
ENTRYPOINT ["/usr/src/app/entrypoint.sh"]
