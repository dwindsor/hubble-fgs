mkdir prod staging
mv prod.yaml prod/prod.yaml
mv base.yaml prod/base.yaml
mv staging.yaml staging/staging.yaml

netpol diff -o actual prod staging
cmp actual expected

###

-- expected --
Verdict differences
-------------------

0.0.0.0/0:* -> 192.168.0.0/16:22
     Rule                  Proto  Src        SrcPort  SrcVLAN  SrcVRF      Dst             DstPort  DstVLAN  DstVRF      Action
  -  management/Allow_SSH  TCP    0.0.0.0/0  *        0        management  192.168.0.0/16  22       0        management  allow
  +  management/Allow_SSH  TCP    0.0.0.0/0  *        0        management  192.168.0.0/24  22       0        management  allow

