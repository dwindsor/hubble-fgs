# Load some flows
load-flows flows.table

# Insert the production and staging policies
db/insert policies management.yaml
db/insert policies management-staging.yaml

# Verify that the policy was patched.
# Expecting connection to 192.168.0.1:22 to allow->deny and
# 192.168.1.1:22 to deny->allow.
# Confidence is 30% as we had threshold of 5 connections (default for test)
# and 13% had differing verdicts (2 out of 15) (see [confidenceTable]).
print-patch
* cmp stdout expected-patch

-- expected-patch --
default/management-staging
[
  {
    "op": "replace",
    "path": "/metadata/annotations/smartswitchnetworkpolicies.isovalent.com~1validation",
    "value": "{\"TargetGeneration\":1,\"StagingGeneration\":1,\"AllowToDeny\":1,\"DenyToAllow\":1,\"Confidence\":0.3,\"Sample\":[\"192.168.1.1:12345 -\\u003e 192.168.0.1:22 TCP deny | allow -\\u003e no-match\",\"192.168.1.1:12345 -\\u003e 192.168.1.1:22 TCP allow | deny -\\u003e allow\"]}"
  }
]
-- management.yaml --
policy:
    name: default/management
    generation: 1
    rules:
        - index: 0
          policyname: management
          rulename: Allow_SSH
          source:
            prefix: 192.168.0.0/16
            minport: 0
            maxport: 65535
            vlan: 0
            vrf: management
            protocol: TCP
          destination:
            prefix: 192.168.0.0/16
            minport: 22
            maxport: 22
            vlan: 0
            vrf: management
            protocol: ""
          action: allow
          highlight: false
        - index: 0
          policyname: management
          rulename: Deny_1_1
          source:
            prefix: 192.168.0.0/16
            minport: 0
            maxport: 65535
            vlan: 0
            vrf: management
            protocol: TCP
          destination:
            prefix: 192.168.1.1/32
            minport: 22
            maxport: 22
            vlan: 0
            vrf: management
            protocol: ""
          action: deny
          highlight: false
target: ""
status:
    kind: ""

-- management-staging.yaml --
policy:
    name: default/management-staging
    generation: 1
    rules:
        - index: 0
          policyname: management-staging
          rulename: Allow_SSH
          source:
            prefix: 192.168.0.0/16
            minport: 0
            maxport: 65535
            vlan: 0
            vrf: management
            protocol: TCP
          destination:
            prefix: 192.168.1.0/24
            minport: 22
            maxport: 22
            vlan: 0
            vrf: management
            protocol: ""
          action: allow
          highlight: false
target: default/management
status:
    id: 1
    kind: Pending


