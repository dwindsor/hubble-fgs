set -e
set -u
set -x

OSS_GIT="./modules/tetragon-oss"

GOPRIVATE="github.com/isovalent"

function main() {
    version=$(GIT_DIR="$OSS_GIT/.git" git rev-parse HEAD)

    GOPRIVATE=$GOPRIVATE go get "github.com/cilium/tetragon@$version"
}

if [ "${NO_OSS_DEPFIX:-0}" != 1 ]; then
	main "$@"
fi
