//       ports:
//         protocol: "TCP"
//     - ipBlock:
//         cidr: "142.250.217.78/24" # google
//       ports:
//         protocol: "TCP"
//     - FQDN:
//       - "ebpf.io"
//       - "tetragon.io"
//       ports:
//         protocol: "TCP"
//         ports: [80, 8080]

func TestNetworkPolicyReconciler_Reconcile(t *testing.T) {
	type fields struct {
		Client client.Client
		Scheme *runtime.Scheme
	}
	type args struct {
		ctx context.Context
		req ctrl.Request
	}
	tests := []struct {
		name    string
		pods    corev1.PodList
		netpol  v1alpha1.TetragonNetworkPolicy
		requeue bool
		wantErr bool
	}{
		{
			name: "first",
			netpol: v1alpha1.TetragonNetworkPolicy{
				TypeMeta: v1.TypeMeta{
					Kind:       "TetragonNetworkPolicy",
					APIVersion: "cilium.io/v1alpha1",
				},
				ObjectMeta: v1.ObjectMeta{
					Name: "simple-policy",
				},
			},
		},
	}
	for _, tt := range tests {
		t.Run(tt.name, func(t *testing.T) {
			client := getFakeClientBuilder().WithLists(&tt.pods).WithObjects(&tt.netpol).Build()
			reconciler := NetworkPolicyReconciler{Client: client}
			res, err := reconciler.Reconcile(t.Context(), reconcile.Request{
				NamespacedName: types.NamespacedName{
					Name:      tt.netpol.Name,
					Namespace: tt.netpol.Namespace,
				},
			})
			if (err != nil) != tt.wantErr {
				t.Errorf("NetworkPolicyReconciler.Reconcile() error = %v, wantErr %v", err, tt.wantErr)
				return
			}
			// if res.Requeue != requeue {
			// 	t.Errorf("NetworkPolicyReconciler.Reconcile() wan", got, tt.want)
			// }
			t.Log(res)
		})
	}
}
