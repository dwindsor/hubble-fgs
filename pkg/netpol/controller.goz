package netpol

import (
	"context"

	"github.com/cilium/tetragon/pkg/k8s/apis/cilium.io/v1alpha1"
	"github.com/cilium/tetragon/pkg/logger"
	"k8s.io/apimachinery/pkg/api/errors"
	"k8s.io/apimachinery/pkg/runtime"
	ctrl "sigs.k8s.io/controller-runtime"
	"sigs.k8s.io/controller-runtime/pkg/client"
)

// NetworkPolicyReconciler reconciles a TetragonNetworkPolicy object
type NetworkPolicyReconciler struct {
	client.Client
	Scheme *runtime.Scheme
}

func (r *NetworkPolicyReconciler) Reconcile(ctx context.Context, req ctrl.Request) (ctrl.Result, error) {
	// _ = logf.FromContext(ctx)

	netpol := &v1alpha1.TetragonNetworkPolicy{}
	if err := r.Get(ctx, req.NamespacedName, netpol); err != nil {
		if errors.IsNotFound(err) {
			// Network policy was deleted
			logger.GetLogger().Info("delete the policy")
		}
		return ctrl.Result{}, err
	}
	// your logic here

	internalNetpol, err := ToInternalTetragonNetworkPolicies(netpol)
	if err != nil {
		return ctrl.Result{}, err
	}

	loadPolicy()

	logger.GetLogger().Info("do stuff", netpol.Name)

	return ctrl.Result{}, nil
}
