{
  "compilerOptions": {
    "rootDir": "../",
    "outDir": "lib",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "allowImportingTsExtensions": true,
    "target": "ES2023",
    "incremental": true,
    "declaration": true,
    "sourceMap": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "emitDeclarationOnly": true,
    "noEmitOnError": true,
    "resolveJsonModule": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": true,
    "strict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "strictPropertyInitialization": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noUnusedLocals": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noErrorTruncation": true,
    "types": [
      "vite/client"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@ipa/*": [
        "../vendor/github.com/isovalent/ipa/*"
      ],
      "@bufbuild/protobuf": [
        "./node_modules/@bufbuild/protobuf/dist/esm/index.d.ts"
      ],
      "@bufbuild/protobuf/wkt": [
        "./node_modules/@bufbuild/protobuf/dist/esm/wkt/index.d.ts"
      ],
      "@bufbuild/protobuf/codegenv2": [
        "./node_modules/@bufbuild/protobuf/dist/esm/codegenv2/index.d.ts"
      ]
    }
  },
  "files": [
    "./vite.config.ts",
    "./postcss.config.cjs"
  ],
  "include": [
    "./src/**/*",
    "../vendor/github.com/isovalent/ipa/application_model/**/*",
    "../vendor/github.com/isovalent/ipa/common/k8s/**/*"
  ],
  "exclude": [
    "./node_modules/*"
  ]
}