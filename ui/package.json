{
  "private": true,
  "name": "@isovalent/process-ancestry",
  "version": "0.1.0",
  "description": "Isovalent Process Ancestry",
  "type": "module",
  "main": "./lib/process-ancestry.umd.cjs",
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "start": "npm run dev",
    "build": "run-p build:*",
    "watch": "run-p watch:*",
    "build:lib": "APP_TYPE=lib NODE_ENV=production vite build",
    "build:app": "APP_TYPE=app NODE_ENV=production vite build",
    "watch:lib": "APP_TYPE=lib NODE_ENV=production vite build --watch ",
    "watch:app": "APP_TYPE=app NODE_ENV=production vite build --watch ",
    "dev": "NODE_ENV=development vite",
    "test": "echo \"Error: no test specified\" && exit 1",
    "upgrade-deps": "ncu --interactive --format group"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.5.2",
    "@floating-ui/react": "0.27.12",
    "clsx": "2.1.1",
    "events": "3.3.0",
    "hash-sum": "2.0.0",
    "ipaddr.js": "2.2.0",
    "lodash": "4.17.21",
    "ts-case-convert": "2.1.0",
    "typed-emitter": "2.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/events": "3.0.3",
    "@types/hash-sum": "1.0.2",
    "@types/lodash": "4.17.17",
    "@types/node": "24.0.0",
    "@types/react": "19.1.7",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "npm-check-updates": "18.0.1",
    "npm-run-all": "4.1.5",
    "postcss-nesting": "13.0.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-checker": "0.9.3",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vite-plugin-singlefile": "2.2.0"
  },
  "peerDependencies": {
    "react": "19.0.0",
    "react-dom": "19.0.0"
  }
