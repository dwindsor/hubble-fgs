{
  "name": "@isovalent-eng-npm/process-tree-app-model",
  "version": "0.2.1",
  "description": "Isovalent Process Tree App Model",
  "publishConfig": {
    "registry": "https://artifactory.devhub-cloud.cisco.com/artifactory/api/npm/isovalent-eng-npm/"
  },
  "type": "module",
  "main": "./lib/process-ancestry.umd.cjs",
  "module": "./lib/process-ancestry.js",
  "types": "./lib/process-ancestry.d.ts",
  "exports": {
    ".": {
      "types": "./lib/process-ancestry.d.ts",
      "import": "./lib/process-ancestry.js",
      "require": "./lib/process-ancestry.umd.cjs"
    }
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "start": "npm run dev",
    "build": "run-p build:*",
    "watch": "run-p watch:*",
    "build:lib": "APP_TYPE=lib NODE_ENV=production vite build",
    "build:app": "APP_TYPE=app NODE_ENV=production vite build",
    "watch:lib": "APP_TYPE=lib NODE_ENV=production vite build --watch ",
    "watch:app": "APP_TYPE=app NODE_ENV=production vite build --watch ",
    "dev": "NODE_ENV=development vite",
    "test": "echo \"Error: no test specified\" && exit 1",
    "upgrade-deps": "ncu --interactive --format group"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.11.0",
    "@floating-ui/react": "0.27.17",
    "clsx": "2.1.1",
    "events": "3.3.0",
    "hash-sum": "2.0.0",
    "ipaddr.js": "2.3.0",
    "lodash": "4.17.23",
    "ts-case-convert": "2.1.0",
    "typed-emitter": "2.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/events": "3.0.3",
    "@types/hash-sum": "1.0.2",
    "@types/lodash": "4.17.23",
    "@types/node": "25.2.2",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.1.4",
    "npm-check-updates": "19.3.2",
    "npm-run-all": "4.1.5",
    "postcss-nesting": "14.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-checker": "0.12.0",
    "vite-plugin-dts": "4.5.4",
    "vite-plugin-lib-inject-css": "2.2.2",
    "vite-plugin-singlefile": "2.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
