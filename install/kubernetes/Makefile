REPO_ROOT := $(shell git rev-parse --show-toplevel)
OSS_CHART := $(REPO_ROOT)/modules/tetragon-oss/install/kubernetes/tetragon
EE_PATCHES := enterprise
EE_CHART := tetragon
CHART_YAML_FILES := $(OSS_CHART)/Chart.yaml $(EE_PATCHES)/Chart.yaml
VALUES_YAML_FILES := $(OSS_CHART)/values.yaml $(EE_PATCHES)/reset-export.yaml $(EE_PATCHES)/values.yaml

define merge_yamls
echo "# File generated by Makefile. DO NOT EDIT." > $(2); \
docker run --rm -v $(REPO_ROOT):$(REPO_ROOT) -w $(REPO_ROOT)/install/kubernetes mikefarah/yq  eval-all '. as $$item ireduce ({}; . * $$item)' $(1) >> $(2)
endef

.PHONY: all
all: $(EE_CHART)

.PHONY: $(EE_CHART)
$(EE_CHART): $(OSS_CHART) $(EE_PATCHES)
	$(MAKE) oss-override
	$(MAKE) $(EE_CHART)/Chart.yaml
	$(MAKE) $(EE_CHART)/values.yaml
	$(MAKE) $(EE_CHART)/templates
	$(MAKE) $(EE_CHART)/README.md

.PHONY: clean
clean:
	rm -rf $(EE_CHART)

.PHONY: oss-override
oss-override: $(OSS_CHART) clean
	cp -r $(OSS_CHART) $(EE_CHART)
	rm -f $(EE_CHART)/LICENSE

.PHONY: $(EE_CHART)/Chart.yaml
$(EE_CHART)/Chart.yaml:
	$(call merge_yamls,$(CHART_YAML_FILES),$@)

.PHONY: $(EE_CHART)/values.yaml
$(EE_CHART)/values.yaml:
	$(call merge_yamls,$(VALUES_YAML_FILES),$@)

.PHONY: $(EE_CHART)/templates
$(EE_CHART)/templates:
	cp -rf $(EE_PATCHES)/templates/. $(EE_CHART)/templates

.PHONY: $(EE_CHART)/README.md
$(EE_CHART)/README.md:
	./test.sh
