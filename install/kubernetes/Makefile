include ../../Makefile.defs
include $(OSS_DIR)/Makefile.defs

#
# -- Images
#
# renovate: datasource=docker
HELM_IMAGE = docker.io/alpine/helm:3.16.1@sha256:e057182827e6273fc7e64b8b2b8809cbb71d84e0dd0f88310712f45879854062
# renovate: datasource=docker
KUBECONFORM_IMAGE = ghcr.io/yannh/kubeconform:v0.6.7-alpine@sha256:824e0c248809e4b2da2a768b16b107cf17ada88a89ec6aa6050e566ba93ebbc6
# renovate: datasource=docker
HELMDOCS_IMAGE = docker.io/jnorwood/helm-docs:v1.14.2@sha256:7e562b49ab6b1dbc50c3da8f2dd6ffa8a5c6bba327b1c6335cc15ce29267979c
# renovate: datasource=docker
PYTHON_IMAGE = docker.io/python:3.12-slim-bookworm
# renovate: datasource=docker
YQ_IMAGE = docker.io/mikefarah/yq:4.44.3@sha256:5b3d851bf28b04ef902fee86305f4dd7e063919c1cafedab2042adb16221c025

#
# -- Versions
#
# renovate: datasource=github-releases depName=yannh/kubeconform
KUBECONFORM_VERSION = v0.6.7
K8S_VERSION = master

#
# -- Variables
#
HELM_VALUES_OVERRIDE = helm_lint_values_override.yaml
OSS_CHART := $(OSS_DIR)/install/kubernetes/tetragon
EE_PATCHES = enterprise
EE_CHART = tetragon
CHART_YAML_FILES := $(OSS_CHART)/Chart.yaml $(EE_PATCHES)/Chart.yaml
VALUES_YAML_FILES := $(OSS_CHART)/values.yaml $(EE_PATCHES)/reset-export.yaml $(EE_PATCHES)/values.yaml
CRDS_RELATIVE_DIR = pkg/k8s/apis/cilium.io/client/crds/v1alpha1
CRDS := $(ROOT_DIR)/$(CRDS_RELATIVE_DIR)
JSON_SCHEMAS := $(ROOT_DIR)/install/kubernetes/schemas
TARGET_MAX_CHAR_NUM = 25

#
# -- Commands
#
PYTHON := docker run --rm \
		-v $(ROOT_DIR):/code \
		--workdir=/code/install/kubernetes \
		-e FILENAME_FORMAT='{kind}-{fullgroup}' \
		$(PYTHON_IMAGE)
HELM := docker run --rm -u $(shell id -u):$(shell id -g) \
		-v $(CURDIR)/$(EE_CHART):/apps \
		-v $(CURDIR)/$(HELM_VALUES_OVERRIDE):/$(HELM_VALUES_OVERRIDE) \
		$(HELM_IMAGE) \
		--registry-config "/apps/.helm/.config/registry/config.json" \
		--repository-cache "/apps/.helm/.cache/repository" \
		--repository-config "/apps/.helm/.config/repositories.yaml"

#
# -- Helper functions
#
define merge_yamls
echo "# File generated by Makefile. DO NOT EDIT." > $(2); \
docker run --rm -v $(ROOT_DIR):$(ROOT_DIR) -w $(ROOT_DIR)/install/kubernetes $(YQ_IMAGE) eval-all '. as $$item ireduce ({}; . * $$item)' $(1) >> $(2)
endef

#
# -- Make targets
#

##@ Build

.PHONY: all
all: tetragon ## Run all build-related Makefile targets

.PHONY: tetragon
tetragon: $(OSS_CHART) $(EE_PATCHES) ## Generate and validate Tetragon Enterprise Helm chart
	# Add enterprise bits into the OSS chart
	$(MAKE) oss-override
	$(MAKE) tetragon/Chart.yaml
	$(MAKE) tetragon/values.yaml
	$(MAKE) tetragon/templates
	$(MAKE) tetragon/charts
	$(MAKE) docs

.PHONY: oss-override
oss-override: $(OSS_CHART) clean ## Copy Tetragon OSS bits to the EE chart base template
	cp -r $(OSS_CHART) $(EE_CHART)
	rm -f $(EE_CHART)/LICENSE

.PHONY: tetragon/Chart.yaml
tetragon/Chart.yaml: ## Merge Chart.yaml from OSS and EE
	$(call merge_yamls,$(CHART_YAML_FILES),$@)
	# Chart.lock file is manually copied back from tetragon to enterprise directory for now.
	cp -f $(EE_PATCHES)/Chart.lock $(EE_CHART)/Chart.lock

.PHONY: tetragon/values.yaml
tetragon/values.yaml: ## Merge values.yaml from OSS and EE
	$(call merge_yamls,$(VALUES_YAML_FILES),$@)

.PHONY: tetragon/templates
tetragon/templates: $(CRDS) $(EE_PATCHES) ## Copy EE specific patched into the EE Helm chart (CRs, CRDs, etc.)
	cp -rf $(CRDS)/. $(EE_CHART)/crds-yaml
	cp -rf $(EE_PATCHES)/default-policies/. $(EE_CHART)/default-policies
	cp -rf $(EE_PATCHES)/dashboards/. $(EE_CHART)/dashboards
	cp -rf $(EE_PATCHES)/templates/. $(EE_CHART)/templates

.PHONY: tetragon/charts
tetragon/charts: ## Fetch and update the dependency Helm charts
	$(HELM) repo add prometheus-community https://prometheus-community.github.io/helm-charts
	$(HELM) repo update prometheus-community
	$(HELM) dependency update

.PHONY: docs
docs: ## Generate Helm docs for the README.md
	docker run --rm -v $(CURDIR)/$(EE_CHART):/helm-docs -u $$(id -u) $(HELMDOCS_IMAGE)

##@ Cleanup

.PHONY: clean
clean: ## Cleanup Tetragon Enterprise Helm chart
	rm -rf $(EE_CHART)

##@ Validation

.PHONY: validation
validation: ## Validate/lint the Helm chart and all its resources
	$(MAKE) lint
	$(MAKE) kubeconform

.PHONY: openapi2jsonschema.py
openapi2jsonschema.py: ## openapi2jsonschema.py script generating JSON schema from the CRD YAML spec.
	curl -sSfLO https://raw.githubusercontent.com/yannh/kubeconform/$(KUBECONFORM_VERSION)/scripts/$@

.PHONY: lint
lint: ## Lint the Helm chart
	$(HELM) lint . --with-subcharts

.PHONY: kubeconform
## To validate (using openapi2jsonschema.py) default rule set policies included in the Helm chart, we need to have the JSON schema of the TracingPolicy CRD.
## Run kubeconform Helm chart validation checks to validate the templated Kubernetes (custom) resources against their spec.
## Skip validating the Tetragon CRDs themselves (circular dependency)
kubeconform: ## Validate Helm chart using kubeconform
	mkdir -p $(JSON_SCHEMAS)/
	$(PYTHON) /bin/bash -c "pip install pyyaml && python /code/install/kubernetes/openapi2jsonschema.py /code/$(CRDS_RELATIVE_DIR)/*"
	mv $(ROOT_DIR)/install/kubernetes/*-cilium.io.json $(JSON_SCHEMAS)/
	$(MAKE) $(EE_CHART)/charts
	@echo "## Testing Helm chart: \"$(EE_CHART)\""
	$(HELM) template $(EE_CHART) . \
	-f values.yaml \
	-f /$(HELM_VALUES_OVERRIDE) \
	| docker run --rm -i -v $(JSON_SCHEMAS):/schemas $(KUBECONFORM_IMAGE) \
		-summary \
		-verbose \
		-schema-location default \
		-schema-location '/schemas/{{ .ResourceKind }}-{{ .Group }}.json' \
		-skip CustomResourceDefinition \
		-strict \
		-kubernetes-version $(K8S_VERSION)
	rm -rf $(JSON_SCHEMAS)/

##@ Documentation

.PHONY: help
help: ## Display this help, based on https://www.thapaliya.com/en/writings/well-documented-makefiles/
	$(call print_help_from_comments)