# Chainguard glibc-openssl image (wolfi-based, includes apk)
# renovate: datasource=docker depName=artifactory.devhub-cloud.cisco.com/sto-cg-docker/glibc-openssl
ARG BASE_IMAGE=artifactory.devhub-cloud.cisco.com/sto-cg-docker/glibc-openssl:v16.2-dev

FROM ${BASE_IMAGE}
USER root

RUN apk add --no-cache clang-18-extras

USER 65532:65532
WORKDIR /fgs

ENTRYPOINT ["/usr/bin/clang-format"]
CMD ["--help"]
