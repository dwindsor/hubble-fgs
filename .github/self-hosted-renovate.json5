// Self-Hosted Configuration
//
// this contains exclusively self-hosted configuration for the renovate runner
// see https://docs.renovatebot.com/self-hosted-configuration/
//
// having the same files for self-hosted configuration and repository brings
// issues because it will be read twice, one time by the runner to start and
// one time when processing the repository, duplicating regexes detection for
// examples and failing to update them correctly.
//
// For OSS it was simpler because we could disable the read of the repository
// config since everything was already present in the runner's config. However
// here, it's still a bit unclear, but apparently it's not possible because we
// use OSS config to extend the repository EE config.
{
  "username": "isovalent-renovate[bot]",
  // this is a repository setting needed to avoid renovate to fetch
  // https://api.github.com/user and fail because it does not have the auth
  "gitAuthor": "isovalent-renovate[bot] <141654053+isovalent-renovate[bot]@users.noreply.github.com>",
  "repositories": ["isovalent/hubble-fgs"],
  // renovate first reads this configuration, then reads the repository
  // configuration, since we don't split between the self-hosted and the
  // repository configuration, this can lead to duplicate of some areas of the
  // config, for example the regex. See:
  // https://docs.renovatebot.com/self-hosted-configuration/#requireconfig
  "allowedPostUpgradeCommands": [
    "^/tmp/install-buildx$",
    "^make protogen$",
    "^make crds$",
    "^make vendor$",
    "^install/kubernetes/test.sh$",
    "^go mod vendor$",
    "^install-tool golang \\$\\(grep -oP '\\^go \\\\K\\.\\+' go\\.mod\\)$",
    "^make -C install/kubernetes$",
    "^make metrics-docs",
  ],
}
