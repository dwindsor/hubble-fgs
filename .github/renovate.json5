// Repository Configuration
// see https://docs.renovatebot.com/configuration-options/
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitAuthor": "isovalent-renovate[bot] <141654053+isovalent-renovate[bot]@users.noreply.github.com>",
  "extends": [
    "github>cilium/tetragon//.github/renovate.json5",
  ],
  "baseBranches": [
    "master",
    "v1.12",
    "v1.11",
    "v1.10",
  ],
  "cloneSubmodules": true,
  // remove the following is when already set in OSS config
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      // no updates into stable branches (apart from security ones)
      "enabled": false,
      "matchPackagePatterns": ["*"],
      "matchBaseBranches": [
        "v1.12",
        "v1.11",
        "v1.10",
      ]
    },
    {
      // update the base image for stable branches
      "enabled": true,
      "matchPackageNames": ["docker.io/library/alpine"],
      "matchBaseBranches": [
        "v1.12",
        "v1.11",
        "v1.10",
      ]
    },
    {
      "enabled": true,
      "matchPackageNames": [
        "docker.io/library/golang",
        "go"
      ],
      "allowedVersions": "/^1\\.21\\.[0-9]+-?(alpine)?$/",
      "matchBaseBranches": [
        "v1.12",
      ]
    },
    {
      "enabled": true,
      "matchPackageNames": [
        "docker.io/library/golang",
        "go"
      ],
      "allowedVersions": "/^1\\.20\\.[0-9]+-?(alpine)?$/",
      "matchBaseBranches": [
        "v1.11",
      ]
    },
    {
      "enabled": true,
      "matchPackageNames": [
        "docker.io/library/golang",
        "go"
      ],
      "allowedVersions": "/^1\\.19\\.[0-9]+-?(alpine)?$/",
      "matchBaseBranches": [
        "v1.10"
      ]
    },
    {
      "matchBaseBranches": [
        "v1.10",
        "v1.11",
      ],
      // This file was renamed to Docker.operator to follow the naming
      // convention from v1.12 and after
      includePaths: ["operator.Dockerfile"]
    },
  ]
}
