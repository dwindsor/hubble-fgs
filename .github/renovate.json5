// Repository Configuration
// see https://docs.renovatebot.com/configuration-options/
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitAuthor": "isovalent-renovate[bot] <141654053+isovalent-renovate[bot]@users.noreply.github.com>",
  "extends": [
    "github>cilium/tetragon//.github/renovate.json5",
  ],
  "baseBranches": [
    "master",
    "v1.14",
    "v1.13",
    "v1.12",
  ],
  "cloneSubmodules": true,
  "packageRules": [
    {
      // no updates into stable branches (apart from security ones)
      "enabled": false,
      "matchPackagePatterns": ["*"],
      "matchBaseBranches": [
        "v1.14",
        "v1.13",
        "v1.12",
      ]
    },
    {
      // update the base image for stable branches
      "enabled": true,
      "matchPackageNames": ["docker.io/library/alpine"],
      "matchBaseBranches": [
        "v1.14",
        "v1.13",
        "v1.12",
      ]
    },
    {
      "enabled": true,
      "groupName": "Go",
      "matchPackageNames": [
        "docker.io/library/golang",
        "go"
      ],
      "allowedVersions": "/^1\\.22\\.[0-9]+-?(alpine)?$/",
      "matchBaseBranches": [
        "v1.14",
        "v1.13",
      ]
    },
    {
      "enabled": true,
      "groupName": "Go",
      "matchPackageNames": [
        "docker.io/library/golang",
        "go"
      ],
      "allowedVersions": "/^1\\.2[1-2]\\.[0-9]+-?(alpine)?$/",
      "matchBaseBranches": [
        "v1.12",
      ]
    },
    {
      // Don't update Tetragon Helm chart directly as it's generated from the
      // OSS chart and enterprise extensions.
      "enabled": false,
      "matchFileNames": [
        "install/kubernetes/tetragon/**",
      ],
    },
    {
      "matchFileNames": [
        "install/kubernetes/enterprise/**",
      ],
      // Generate Tetragon Helm chart
      "postUpgradeTasks": {
        "commands": ["make -C install/kubernetes"],
        "executionMode": "branch",
      },
    },
  ]
}
