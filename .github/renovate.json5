// Repository Configuration
// see https://docs.renovatebot.com/configuration-options/
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitAuthor": "isovalent-renovate[bot] <141654053+isovalent-renovate[bot]@users.noreply.github.com>",
  "extends": [
    "github>cilium/tetragon//.github/renovate.json5",
  ],
  "baseBranchPatterns": [
    "master",
    "v1.19",
    "v1.18",
    "v1.17",
  ],
  "cloneSubmodules": true,
  "prConcurrentLimit": 7,
  "packageRules": [
    {
      // no updates into stable branches (apart from security ones)
      "enabled": false,
      "matchPackageNames": ["*"],
      "matchBaseBranches": [
        "v1.19",
        "v1.18",
        "v1.17",
      ]
    },
    {
      // update the base image for stable branches
      "enabled": true,
      "matchPackageNames": ["docker.io/library/alpine"],
      "matchBaseBranches": [
        "v1.19",
        "v1.18",
        "v1.17",
      ]
    },
    {
      // Chainguard images from Artifactory
      "groupName": "Chainguard Images",
      "matchPackageNames": [
        "artifactory.devhub-cloud.cisco.com/sto-cg-docker/go",
        "artifactory.devhub-cloud.cisco.com/sto-cg-docker/glibc-openssl",
        "artifactory.devhub-cloud.cisco.com/sto-cg-docker/static",
      ],
      "pinDigests": false
    },
    {
      "enabled": true,
      "groupName": "Go",
      "matchPackageNames": [
        "docker.io/library/golang",
        "go"
      ],
      "allowedVersions": "/^1\\.26\\.[0-9]+-?(alpine)?$/",
      "matchBaseBranches": [
        "v1.19",
        "v1.18",
        "v1.17",
      ]
    },
    {
      "groupName": "isovalent",
      "matchPackageNames": [
	"github.com/isovalent/**",
      ],
    },
    // This rule is just a reapply from the more global ignore on docker digest updates from OSS:
    // https://github.com/cilium/tetragon/blob/11d65b823769c5d772520c8f9c0c73c97cc6faad/.github/renovate.json5#L461-L468
    // Since we reenable all Go updates just above and can't combine allowedVersions and matchUpdatesTypes: ["!digest"]
    {
      "enabled": false,
      "matchPackageNames": ["docker.io/library/golang"],
      "matchUpdateTypes": ["digest"],
    },
    {
      // Don't update Tetragon Helm chart directly as it's generated from the
      // OSS chart and enterprise extensions.
      "enabled": false,
      "matchFileNames": [
        "install/kubernetes/tetragon/**",
      ],
    },
    {
      "matchFileNames": [
        "install/kubernetes/enterprise/**",
      ],
      // Generate Tetragon Helm chart
      "postUpgradeTasks": {
        "commands": ["make -C install/kubernetes"],
        "executionMode": "branch",
      },
    },
    {
      // Updates renovate version once a month
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "schedule": ["* * 1 * *"],
    },
    {
      "matchDepNames": [
        "quay.io/isovalent-dev/ipa-builder"
      ],
      // This matches the following two formats:
      // major.minor.patch
      // major.minor.patch-dev.123-20250818154258
      // https://regex101.com/r/q5f7nC/2
      "versioning": "regex:^v?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:-dev\\.(?<build>\\d+)-(?<revision>\\d+))?$",
      "postUpgradeTasks": {
        "commands": ["/tmp/install-buildx", "make vendor", "make protogen"],
        "fileFilters": ["**/**"],
        "executionMode": "branch",
        "installTools": {
           "golang": {}
        }
      }
    },
    {
      // Group ubi base image updates into a single branch
      "groupName": "ubi base image",
      "groupSlug": "ubi-base-image",
      "matchPackageNames": ["registry.redhat.io/ubi9/ubi-minimal"],
      "matchDatasources": ["docker"],
    }
  ],
    "customManagers": [
    {
      "customType": "regex",
      // This matches image references in YAML workflow files (key: name:version@digest)
      // For example:
      // ubi_image: registry.redhat.io/ubi9/ubi-minimal:9.7@sha256:42c0bdc0534c1465e623a193929a66e9abeb214c61c80c360d99a2a491b0336b
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>docker)\\s+\\w+:\\s+(?<depName>[^:\\s]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?"
      ]
    }
  ]
}
