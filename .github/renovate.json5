// Repository Configuration
// see https://docs.renovatebot.com/configuration-options/
{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "gitAuthor": "isovalent-renovate[bot] <141654053+isovalent-renovate[bot]@users.noreply.github.com>",
  "extends": [
    "github>cilium/tetragon//.github/renovate.json5",
  ],
  "baseBranchPatterns": [
    "master",
    "v1.19",
    "v1.18",
    "v1.17",
  ],
  "cloneSubmodules": true,
  "prConcurrentLimit": 7,
  "packageRules": [
    {
      // no updates into stable branches (apart from security ones)
      "enabled": false,
      "matchPackageNames": ["*"],
      "matchBaseBranches": [
        "v1.19",
        "v1.18",
        "v1.17",
      ]
    },
    {
      // update the base image for stable branches
      "enabled": true,
      "matchPackageNames": ["docker.io/library/alpine"],
      "matchBaseBranches": [
        "v1.19",
        "v1.18",
        "v1.17",
      ]
    },
    {
      "enabled": true,
      "groupName": "Go",
      "matchPackageNames": [
        "docker.io/library/golang",
        "go"
      ],
      "allowedVersions": "/^1\\.26\\.[0-9]+-?(alpine)?$/",
      "matchBaseBranches": [
        "v1.19",
        "v1.18",
      ]
    },
    {
      "enabled": true,
      "groupName": "Go",
      "matchPackageNames": [
        "docker.io/library/golang",
        "go"
      ],
      "allowedVersions": "/^1\\.24\\.[0-9]+-?(alpine)?$/",
      "matchBaseBranches": [
        "v1.17",
      ]
    },
    {
      "groupName": "isovalent",
      "matchPackageNames": [
	"github.com/isovalent/**",
      ],
    },
    // This rule is just a reapply from the more global ignore on docker digest updates from OSS:
    // https://github.com/cilium/tetragon/blob/11d65b823769c5d772520c8f9c0c73c97cc6faad/.github/renovate.json5#L461-L468
    // Since we reenable all Go updates just above and can't combine allowedVersions and matchUpdatesTypes: ["!digest"]
    {
      "enabled": false,
      "matchPackageNames": ["docker.io/library/golang"],
      "matchUpdateTypes": ["digest"],
    },
    {
      // Don't update Tetragon Helm chart directly as it's generated from the
      // OSS chart and enterprise extensions.
      "enabled": false,
      "matchFileNames": [
        "install/kubernetes/tetragon/**",
      ],
    },
    {
      "matchFileNames": [
        "install/kubernetes/enterprise/**",
      ],
      // Generate Tetragon Helm chart
      "postUpgradeTasks": {
        "commands": ["make -C install/kubernetes"],
        "executionMode": "branch",
      },
    },
    {
      // Updates renovate version once a month
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate"],
      "schedule": ["* * 1 * *"],
    }
  ]
}
